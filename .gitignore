# Dependencies
node_modules/

# Build output
dist/
packages/web/dev-dist/
.cache/

# Local data collection scratch, never part of the project
scratch/

# Secrets and local environment
.env
.env.*
!.env.example

# Logs and editor or OS noise
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Headlines gathered at deploy time by scripts/build-news.mjs, never committed
packages/web/public/news-snapshot.json

# Meetings and agendas read from city agenda sites by scripts/build-agendas.mjs, never committed
packages/web/public/agendas-snapshot.json

# On-device vision models, fetched by scripts/fetch-models.mjs (about 10 MB)
packages/web/public/models/

# Translation work files from scripts/i18n-todo.mjs, merged by scripts/i18n-apply.mjs
data/i18n/work/
